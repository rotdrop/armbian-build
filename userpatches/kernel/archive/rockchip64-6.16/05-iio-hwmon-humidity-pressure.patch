From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claus-Justus Heine <himself@claus-justus-heine.de>
Date: Sun, 31 Aug 2025 12:45:02 +0000
Subject: Patching kernel rockchip64 files drivers/hwmon/iio_hwmon.c

Signed-off-by: Claus-Justus Heine <himself@claus-justus-heine.de>
---
 drivers/hwmon/iio_hwmon.c | 19 ++++++++--
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/hwmon/iio_hwmon.c b/drivers/hwmon/iio_hwmon.c
index e376d4cde5ad..05f31b83d948 100644
--- a/drivers/hwmon/iio_hwmon.c
+++ b/drivers/hwmon/iio_hwmon.c
@@ -62,15 +62,24 @@ static ssize_t iio_hwmon_read_val(struct device *dev,
 
 	ret = iio_get_channel_type(chan, &type);
 	if (ret < 0)
 		return ret;
 
-	if (type == IIO_POWER)
+	switch (type) {
+	case IIO_POWER:
 		/* mili-Watts to micro-Watts conversion */
 		ret = iio_read_channel_processed_scale(chan, &result, 1000);
-	else
+		break;
+	case IIO_HUMIDITYRELATIVE:
 		ret = iio_read_channel_processed(chan, &result);
+		if (ret >= 0)
+			result = (result + 500) / 1000;
+		break;
+	default:
+		ret = iio_read_channel_processed(chan, &result);
+		break;
+	}
 	if (ret < 0)
 		return ret;
 
 	return sprintf(buf, "%d\n", result);
 }
@@ -79,11 +88,11 @@ static int iio_hwmon_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct iio_hwmon_state *st;
 	struct sensor_device_attribute *a;
 	int ret, i, attr = 0;
-	int in_i = 1, temp_i = 1, curr_i = 1, humidity_i = 1, power_i = 1;
+	int in_i = 1, temp_i = 1, curr_i = 1, humidity_i = 1, power_i = 1, pressure_i = 1;
 	enum iio_chan_type type;
 	struct iio_channel *channels;
 	struct device *hwmon_dev;
 	char *sname;
 	void *buf;
@@ -146,10 +155,14 @@ static int iio_hwmon_probe(struct platform_device *pdev)
 			break;
 		case IIO_HUMIDITYRELATIVE:
 			n = humidity_i++;
 			prefix = "humidity";
 			break;
+		case IIO_PRESSURE:
+			n = pressure_i++;
+			prefix = "pressure";
+			break;
 		default:
 			return -EINVAL;
 		}
 
 		a->dev_attr.attr.name = devm_kasprintf(dev, GFP_KERNEL,
