From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Thu, 8 Oct 2026 11:49:22 +0000
Subject: Patching kernel rockchip64 files drivers/mfd/rk8xx-core.c

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 drivers/mfd/rk8xx-core.c | 8 ++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/mfd/rk8xx-core.c b/drivers/mfd/rk8xx-core.c
--- a/drivers/mfd/rk8xx-core.c
+++ b/drivers/mfd/rk8xx-core.c
@@ -875,8 +875,14 @@ int rk8xx_probe(struct device *dev, int variant, unsigned int irq, struct regmap
 
 	if (device_property_read_bool(dev, "system-power-controller") ||
 	    device_property_read_bool(dev, "rockchip,system-power-controller")) {
+		enum sys_off_mode poweroff_mode = SYS_OFF_MODE_POWER_OFF_PREPARE;
+
+		/* Quartz64: the RK817 ignores DEV_OFF in the prepare step. */
+		if (variant == RK809_ID || variant == RK817_ID)
+			poweroff_mode = SYS_OFF_MODE_POWER_OFF;
+
 		ret = devm_register_sys_off_handler(dev,
-				    SYS_OFF_MODE_POWER_OFF_PREPARE, SYS_OFF_PRIO_HIGH,
+				    poweroff_mode, SYS_OFF_PRIO_HIGH,
 				    &rk808_power_off, rk808);
 		if (ret)
 			return dev_err_probe(dev, ret,
