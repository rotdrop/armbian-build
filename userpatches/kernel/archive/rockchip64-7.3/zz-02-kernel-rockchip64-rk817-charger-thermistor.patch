From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Thu, 8 Oct 2026 09:36:15 +0000
Subject: Patching kernel rockchip64 files drivers/power/supply/rk817_charger.c
 include/linux/mfd/rk808.h

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 drivers/power/supply/rk817_charger.c | 97 +++++++++++++++++++++++++-
 include/linux/mfd/rk808.h            |  2 +
 2 files changed, 99 insertions(+), 2 deletions(-)

diff --git a/drivers/power/supply/rk817_charger.c b/drivers/power/supply/rk817_charger.c
--- a/drivers/power/supply/rk817_charger.c
+++ b/drivers/power/supply/rk817_charger.c
@@ -14,10 +14,12 @@
 #include <linux/irq.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
+#include <linux/int_log.h>
+#include <linux/math64.h>
 
 /* Charging statuses reported by hardware register */
 enum rk817_charge_status {
 	CHRG_OFF,
 	DEAD_CHRG,
@@ -100,11 +101,11 @@ struct rk817_charger {
 	 */
 	int fcc_mah;
 
 	/*
 	 * Calibrate the SOC on a fully charged battery, this way we can use
-	 * the calibrated SOC value to correct for columb counter drift.
+	 * the calibrated SOC value to correct for coulomb counter drift.
 	 */
 	bool soc_cal;
 
 	/* Implementation specific immutable properties from device tree */
 	int res_div;
@@ -112,19 +114,26 @@ struct rk817_charger {
 	int sleep_filter_current_ua;
 	int bat_charge_full_design_uah;
 	int bat_voltage_min_design_uv;
 	int bat_voltage_max_design_uv;
 
+	u32 bat_thermistor_b_constant;
+	u32 bat_thermistor_pivot_resistance_ohms;
+	u32 bat_thermistor_pivot_temperature_kelvin;
+	bool bat_thermistor_valid;
+
 	/* Values updated periodically by driver for display. */
 	int charge_now_uah;
 	int volt_avg_uv;
 	int cur_avg_ua;
 	int max_chg_cur_ua;
 	int max_chg_volt_uv;
 	int charge_status;
 	int charger_input_volt_avg_uv;
 	u32 usb_input_current_limit_ua;
+	int bat_ts_decicelsius;
+	bool bat_ts_valid;
 
 	/* Work queue to periodically update values. */
 	struct delayed_work work;
 };
 
@@ -473,10 +482,54 @@ static void rk817_read_props(struct rk817_charger *charger)
 		charger->charger_input_volt_avg_uv = tmp * 1000;
 	} else {
 		charger->charger_input_volt_avg_uv = 0;
 	}
 
+	/*
+	 * The ADC spans 0 to 1.2 V. The datasheet does not specify the
+	 * thermistor current; 75 uA is the measured value used here.
+	 */
+	if (charger->bat_thermistor_valid) {
+		int ret;
+
+		charger->bat_ts_valid = false;
+		ret = regmap_bulk_read(charger->rk808->regmap,
+				       RK817_GAS_GAUGE_BAT_TS_H, bulk_reg, 2);
+		if (ret) {
+			dev_err_ratelimited(charger->dev,
+					    "failed to read battery thermistor: %d\n",
+					    ret);
+		} else {
+			u32 resistance = (get_unaligned_be16(bulk_reg) * 16000U) >> 16;
+
+			if (resistance) {
+				s64 log_ratio, numerator, denominator, temp_ck;
+
+				/* Convert log2(R/R0) to ln(R/R0), both in Q24. */
+				log_ratio = (s64)intlog2(resistance) -
+					    intlog2(charger->bat_thermistor_pivot_resistance_ohms);
+				log_ratio = div_s64(log_ratio * 11629080LL,
+						    1LL << 24);
+				numerator = (s64)charger->bat_thermistor_b_constant *
+					    charger->bat_thermistor_pivot_temperature_kelvin *
+					    100;
+				denominator =
+					(s64)charger->bat_thermistor_b_constant * 100 +
+					div_s64((s64)charger->bat_thermistor_pivot_temperature_kelvin *
+						log_ratio, 1LL << 24);
+				if (denominator > 0) {
+					temp_ck = div_s64(numerator, denominator);
+					if (temp_ck <= 0x7fffffffLL) {
+						charger->bat_ts_decicelsius =
+							div_s64(temp_ck - 27315, 10);
+						charger->bat_ts_valid = true;
+					}
+				}
+			}
+		}
+	}
+
 	/* Calibrate battery capacity and soc. */
 	rk817_bat_calib_cap(charger);
 }
 
 static int rk817_bat_get_prop(struct power_supply *ps,
@@ -571,10 +624,15 @@ static int rk817_bat_get_prop(struct power_supply *ps,
 		val->intval = charger->max_chg_volt_uv;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = charger->bat_voltage_max_design_uv;
 		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!charger->bat_ts_valid)
+			return -ENODATA;
+		val->intval = charger->bat_ts_decicelsius;
+		break;
 	default:
 		return -EINVAL;
 	}
 	return 0;
 }
@@ -699,10 +757,11 @@ static enum power_supply_property rk817_bat_props[] = {
 	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
 	POWER_SUPPLY_PROP_CURRENT_AVG,
 	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_TEMP,
 };
 
 static enum power_supply_property rk817_chg_props[] = {
 	POWER_SUPPLY_PROP_ONLINE,
 	POWER_SUPPLY_PROP_USB_TYPE,
@@ -1096,11 +1155,11 @@ static void rk817_cleanup_node(void *data)
 
 static int rk817_charger_probe(struct platform_device *pdev)
 {
 	struct rk808 *rk808 = dev_get_drvdata(pdev->dev.parent);
 	struct rk817_charger *charger;
-	struct device_node *node;
+	struct device_node *node, *battery_node;
 	struct power_supply_battery_info *bat_info;
 	struct device *dev = &pdev->dev;
 	struct power_supply_config pscfg = {};
 	int plugin_irq, plugout_irq;
 	int of_value;
@@ -1222,10 +1281,46 @@ static int rk817_charger_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
 	power_supply_put_battery_info(charger->bat_ps, bat_info);
 
+	/*
+	 * Thermistor calibration is optional. Keep the battery supply usable
+	 * when the device tree does not provide the calibration properties.
+	 */
+	battery_node = of_parse_phandle(charger->bat_ps->dev.of_node,
+					"monitored-battery", 0);
+	if (!battery_node) {
+		dev_warn(dev, "no monitored battery; temperature unavailable\n");
+	} else {
+		u32 b_constant, pivot_resistance, pivot_temperature;
+
+		ret = of_property_read_u32(battery_node, "thermistor-b-constant",
+					   &b_constant);
+		if (!ret)
+			ret = of_property_read_u32(battery_node,
+						   "thermistor-pivot-resistance-ohms",
+						   &pivot_resistance);
+		if (!ret)
+			ret = of_property_read_u32(battery_node,
+						   "thermistor-pivot-temperature-celsius",
+						   &pivot_temperature);
+		if (ret || !b_constant || !pivot_resistance ||
+		    pivot_temperature > 1000) {
+			dev_warn(dev,
+				 "invalid or missing thermistor calibration; temperature unavailable\n");
+		} else {
+			charger->bat_thermistor_b_constant = b_constant;
+			charger->bat_thermistor_pivot_resistance_ohms =
+				pivot_resistance;
+			charger->bat_thermistor_pivot_temperature_kelvin =
+				pivot_temperature * 100 + 27315;
+			charger->bat_thermistor_valid = true;
+		}
+		of_node_put(battery_node);
+	}
+
 	plugin_irq = platform_get_irq(pdev, 0);
 	if (plugin_irq < 0)
 		return plugin_irq;
 
 	plugout_irq = platform_get_irq(pdev, 1);
diff --git a/include/linux/mfd/rk808.h b/include/linux/mfd/rk808.h
index 7ffc904c864c..957bebb52a85 100644
--- a/include/linux/mfd/rk808.h
+++ b/include/linux/mfd/rk808.h
@@ -1229,10 +1229,12 @@ enum rk809_reg_id {
 #define RK817_GAS_GAUGE_Q_PRES_L0	0x77
 #define RK817_GAS_GAUGE_BAT_VOL_H	0x78
 #define RK817_GAS_GAUGE_BAT_VOL_L	0x79
 #define RK817_GAS_GAUGE_BAT_CUR_H	0x7a
 #define RK817_GAS_GAUGE_BAT_CUR_L	0x7b
+#define RK817_GAS_GAUGE_BAT_TS_H	0x7c
+#define RK817_GAS_GAUGE_BAT_TS_L	0x7d
 #define RK817_GAS_GAUGE_USB_VOL_H	0x7e
 #define RK817_GAS_GAUGE_USB_VOL_L	0x7f
 #define RK817_GAS_GAUGE_SYS_VOL_H	0x80
 #define RK817_GAS_GAUGE_SYS_VOL_L	0x81
 #define RK817_GAS_GAUGE_Q_MAX_H3	0x82
