Date: Sun, 21 Dec 2025 14:00:34 +0000
Subject: Patching kernel rockchip64 files
 drivers/power/supply/power_supply_core.c

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 drivers/power/supply/power_supply_core.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/power/supply/power_supply_core.c b/drivers/power/supply/power_supply_core.c
index 9a28381e2607..c54df8d25350 100644
--- a/drivers/power/supply/power_supply_core.c
+++ b/drivers/power/supply/power_supply_core.c
@@ -1108,10 +1108,14 @@ EXPORT_SYMBOL_GPL(power_supply_get_maintenance_charging_setting);
 int power_supply_ocv2cap_simple(const struct power_supply_battery_ocv_table *table,
 				int table_len, int ocv)
 {
 	int i, high, low;
 
+	for (i = 0; i < table_len; i++) {
+          printk("OCV TABLE %d %d", table[i].ocv, table[i].capacity);
+        }
+
 	for (i = 0; i < table_len; i++)
 		if (ocv > table[i].ocv)
 			break;
 
 	/* The library function will deal with high == low */
@@ -1163,12 +1167,14 @@ int power_supply_batinfo_ocv2cap(struct power_supply_battery_info *info,
 {
 	const struct power_supply_battery_ocv_table *table;
 	int table_len;
 
 	table = power_supply_find_ocv2cap_table(info, temp, &table_len);
-	if (!table)
-		return -EINVAL;
+	if (!table) {
+          printk("*** NO OCV BAT TABLE");
+	  return -EINVAL;
+        }
 
 	return power_supply_ocv2cap_simple(table, table_len, ocv);
 }
 EXPORT_SYMBOL_GPL(power_supply_batinfo_ocv2cap);
 
